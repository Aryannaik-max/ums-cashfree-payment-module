PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ums_payments
CASHFREE_CLIENT_ID=sandbox_client_id
CASHFREE_CLIENT_SECRET=sandbox_client_secret
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2025-01-01
# Must be a public https URL for real webhooks (ngrok URL while testing)
APP_BASE_URL=https://your-ngrok-url.ngrok-free.app
# Optional: if set, /api/payments and /api/fees require header x-api-key
INTERNAL_API_KEY=
RECONCILE_ENABLED=true