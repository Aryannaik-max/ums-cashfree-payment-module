enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  USER_DROPPED
  EXPIRED
  REFUNDED
}

enum FeeStatus {
  UNPAID
  PAID
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum StatusSource {
  API
  WEBHOOK
  RECONCILIATION
}

// Minimal stand-in for the ERP's fee table
model Fee {
  id           String    @id @default(uuid())
  studentId    String
  studentName  String
  studentEmail String
  studentPhone String
  description  String
  amount       Decimal   @db.Decimal(12, 2)
  status       FeeStatus @default(UNPAID)
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]

  @@index([studentId])
}

model Payment {
  id               String                 @id @default(uuid())
  feeId            String
  fee              Fee                    @relation(fields: [feeId], references: [id])
  studentId        String
  orderId          String                 @unique
  cfOrderId        String?
  paymentSessionId String?
  amount           Decimal                @db.Decimal(12, 2)
  currency         String                 @default("INR")
  status           PaymentStatus          @default(CREATED)
  idempotencyKey   String                 @unique
  failureReason    String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  events           PaymentEvent[]
  history          PaymentStatusHistory[]
  refunds          Refund[]

  @@index([status])
  @@index([feeId])
  @@index([studentId])
}

model PaymentEvent {
  id             String    @id @default(uuid())
  paymentId      String?
  payment        Payment?  @relation(fields: [paymentId], references: [id])
  eventId        String    @unique
  eventType      String
  rawPayload     Json
  signatureValid Boolean
  note           String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([paymentId])
}

model PaymentStatusHistory {
  id         String         @id @default(uuid())
  paymentId  String
  payment    Payment        @relation(fields: [paymentId], references: [id])
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  source     StatusSource
  reason     String?
  createdAt  DateTime       @default(now())

  @@index([paymentId])
}

model Refund {
  id             String       @id @default(uuid())
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id])
  refundId       String       @unique
  idempotencyKey String?      @unique
  amount         Decimal      @db.Decimal(12, 2)
  status         RefundStatus @default(PENDING)
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([paymentId])
}